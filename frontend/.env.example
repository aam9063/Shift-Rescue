# Base URL of the Shift Rescue API. Leave empty for same-origin: the Vite dev
# proxy and the deployed Caddy setup both serve /api from the web origin.
VITE_API_BASE_URL=

# Set to "true" to run the dashboard fully offline on mock data (offline demo
# mode; the test suite also forces this). Any other value uses the live API.
VITE_USE_MOCK=false
